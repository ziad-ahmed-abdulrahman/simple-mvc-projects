@{
    ViewBag.Title = "Options";


}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
            background-color: #f8f9fa;
        }

        .center-container {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .cards-row {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .option-card {
            border-radius: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
            cursor: pointer;
            background-color: #ffffff;
            padding: 3rem 1rem;
            text-align: center;
            width: 300px;
        }

            .option-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.2);
            }

            .option-card h3 {
                font-weight: 600;
                font-size: 1.8rem;
            }

            .option-card p {
                font-weight: 400;
                font-size: 1rem;
                line-height: 1.5;
                color: #6c757d;
            }

        .bi {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .encrypt-card .bi,
        .encrypt-card h3 {
            color: #0d6efd;
        }

        .decrypt-card .bi,
        .decrypt-card h3 {
            color: #198754;
        }
    </style>
</head>
<body>
    <div style="height: 30px;"></div>
    <!-- First Row -->
    <div class="center-container" style="margin-bottom:20px;">
        <div class="cards-row d-flex justify-content-center gap-4">

            <!-- AES Encryption -->
            <a asp-controller="AESEncryption" asp-action="Index" class="text-decoration-none" title="Click here to explore AES encryption in detail!">
                <div class="card shadow-lg option-card encrypt-card text-center p-4" style="width: 300px;">
                    <i class="bi bi-lock-fill fs-1 mb-3"></i>
                    <h3>AES</h3>
                  
                    <p>
                        Encrypt and decrypt your text quickly, easily, and securely using the AES encryption.
                    </p>

                </div>
            </a>

            <!-- Caesar Info -->
            <a asp-controller="CaesarEncryption" asp-action="Index" class="text-decoration-none" title="Click here to explore Caesar encryption in detail!">
                <div class="card shadow-lg option-card decrypt-card text-center p-4" style="width: 300px;">
                    <i class="bi bi-key-fill fs-1 mb-3"></i>
                    <h3>Caesar</h3>
                    <p>
                        Decrypt your encrypted text easily and securely using the Caesar cipher.
                    </p>
                   
                </div>
            </a>
        </div>
    </div>


    <!-- Second Row -->
    <div class="center-container" style="margin-bottom:20px;">
        <div class="cards-row d-flex justify-content-center gap-4">

            <!-- AES PDF Report -->
            <a href="~/files/Pdf/AESReport.pdf" target="_blank" class="text-decoration-none" title="Click to open AES PDF Report">
                <div class="card shadow-sm option-card text-center p-4" style="width: 300px; cursor:pointer;">
                    <i class="bi bi-lock fs-2 mb-2" style="color:#0d6efd;"></i>
                    <h3>AES Report</h3>
                    <p>Advanced Encryption Standard (AES) is a symmetric encryption algorithm used worldwide for secure data.</p>
                </div>
            </a>

            <!-- Caesar PDF Report -->
            <a href="~/files/Pdf/CaesarReport.pdf" target="_blank" class="text-decoration-none" title="Click to open Caesar PDF Report">
                <div class="card shadow-sm option-card text-center p-4" style="width: 300px; cursor:pointer;">
                    <i class="bi bi-key fs-2 mb-2" style="color:#198754;"></i>
                    <h3>Caesar Report</h3>
                    <p>
                        The Caesar cipher is a simple substitution cipher easily shifting letters by a fixed number.
                    </p>
                </div>
            </a>

        </div>
    </div>

        

       

         

       


</body>
</html>


