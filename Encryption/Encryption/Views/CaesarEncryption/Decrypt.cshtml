@{
    ViewBag.Title = "Caesar Decryption";

    string inputText = "";
    string inputKey = "";

    if (Context.Request.Method == "POST")
    {
        inputText = Context.Request.Form["text"];
        inputKey = Context.Request.Form["key"];
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>


    <!-- Comment_Lib -->
   @*  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet"> *@
    <!-- #endregion -->

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #d9f0ff, #ffffff);
        }

        .encrypt-container {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 3rem 1rem;
            min-height: calc(100vh - 56px);
        }

        .encrypt-form {
            width: 100%;
            max-width: 600px;
            background-color: #ffffff;
            padding: 4rem 3rem;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        h2 {
            text-align: center;
            margin-bottom: 2rem;
            color: #0d6efd;
            font-weight: 600;
        }

        .form-label {
            font-weight: 700;
            font-size: 1.1rem;
            color: #222;
            width: 90px; /* modified width */
        }

        .form-group-inline {
            display: flex;
            align-items: center;
            margin-bottom: 2rem;
        }

            .form-group-inline input {
                flex: 1;
            }

        .form-buttons {
            display: flex;
            justify-content: flex-start;
            margin-top: 2rem;
        }

        .btn-primary {
            font-weight: 600;
            padding: 0.8rem 1.2rem;
            font-size: 1.1rem;
        }

        .btn-back {
            background-color: #6c757d;
            color: #ffffff;
            font-weight: 500;
            padding: 0.7rem 1.2rem;
            margin-right: 1rem;
        }

        .alert {
            word-break: break-word;
            margin-top: 1.5rem;
        }
        /* Add Photo */
        body {
            margin-bottom: 60px;
            background-image: url('/images/padlocks-8050534_1280.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }
    </style>
</head>
<body>

    <div class="encrypt-container">
        <div class="encrypt-form">
            <h2>Caesar Decryption</h2>

            <form method="post" asp-action="Decrypt">

                <div class="form-group-inline">
                    <label class="form-label me-3">Text</label>
                    <input type="text" name="text"
                           class="form-control form-control-lg"
                           placeholder="Enter text"
                           value="@inputText"
                           required
                           pattern="[A-Za-z\s]+"
                           title="Only letters and spaces are allowed" />
                </div>


                <div class="form-group-inline">
                    <label class="form-label me-3">Key</label>
                    <input type="number" name="key"
                           class="form-control form-control-lg"
                           placeholder="Enter encryption key"
                           value="@inputKey"
                           required
                           min="0" />
                </div>

                <div class="form-buttons">
               

                    <a asp-action="Index" class="btn btn-back">
                        <i class="bi bi-arrow-left me-2"></i> Back
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-unlock me-2"></i> Decrypt

                    </button>

                   
                </div>

            </form>

            @if (ViewBag.DecryptedText != null)
            {
                <div class="alert alert-success">
                    <strong>Decrypted:</strong> @ViewBag.DecryptedText
                </div>
            }
        </div>
    </div>

</body>
</html>
